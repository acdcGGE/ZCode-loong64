+  };
+  if (ClipboardItem) {
+    const write = clipboard.write as unknown as (items: unknown[]) => Promise<void>;
+    await write([
+      new ClipboardItem({
+        "image/png": new Blob([Uint8Array.from(png)], { type: "image/png" }),
+      }),
+    ]);
+    return;
+  }
+  clipboard.writeImage(nativeImage.createFromBuffer(Buffer.from(png)));
